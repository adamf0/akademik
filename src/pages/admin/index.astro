---
import Layout from '../../layouts/Layout.astro';
import { db } from '../../lib/db';
import { getUserFromSession } from '../../lib/auth';

const user = await getUserFromSession(Astro.cookies);
const isAuthorized = Boolean(user && user.role === 'admin');

const revenueRow = isAuthorized
  ? ((await db.prepare("SELECT COALESCE(SUM(total), 0) as totalRevenue, COUNT(*) as orderCount FROM orders WHERE status = 'PAID'").get()) as any)
  : { totalRevenue: 0, orderCount: 0 };

const studentCount = isAuthorized
  ? (((await db.prepare("SELECT COUNT(*) as c FROM users WHERE role = 'student'").get()) as any)?.c || 0)
  : 0;

const productCount = isAuthorized
  ? (((await db.prepare('SELECT COUNT(*) as c FROM products').get()) as any)?.c || 0)
  : 0;

const voucherCount = isAuthorized
  ? (((await db.prepare('SELECT COUNT(*) as c FROM vouchers').get()) as any)?.c || 0)
  : 0;

const recentOrders = isAuthorized
  ? ((await db
      .prepare(`
        SELECT o.*, u.name as buyer_name, u.email as buyer_email, p.title as product_title
        FROM orders o
        JOIN users u ON o.user_id = u.id
        JOIN products p ON o.product_id = p.id
        ORDER BY o.created_at DESC
        LIMIT 10
      `)
      .all()) as any[])
  : [];

const formatIDR = (val: number) =>
  new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', maximumFractionDigits: 0 }).format(val);

const formatDate = (iso: string) =>
  new Intl.DateTimeFormat('id-ID', { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }).format(
    new Date(iso)
  );
---

<Layout
  title="Konsol Operasional Admin | Akademi Creator"
  description="Panel manajemen transaksi, produk katalog, kupon promo, dan percakapan siswa Akademi Creator."
  user={user}
>
  <section class="max-w-7xl mx-auto px-5 sm:px-8 py-10 lg:py-14">
    {!isAuthorized ? (
      <div class="max-w-xl mx-auto rounded-2xl border border-[rgba(232,220,206,0.18)] bg-[#181614] p-8 space-y-5 text-center">
        <h1 class="font-display text-3xl font-bold uppercase text-[#f3efe9]">
          Akses Khusus Administrator Operasional
        </h1>
        <p class="text-sm text-[#b5aea4] leading-relaxed">
          Halaman ini membutuhkan sesi dengan hak akses Administrator. Gunakan tombol pratinjau resmi di bawah untuk membuka konsol manajemen.
        </p>
        <div class="flex flex-wrap items-center justify-center gap-3 pt-2">
          <a
            href="/api/auth/demo?role=admin&redirect=/admin"
            class="btn-crimson min-h-11 px-6 py-3 rounded-xl text-sm font-bold inline-flex items-center"
          >
            Aktifkan Sesi Admin Operasional
          </a>
          <a
            href="/auth/login?redirect=/admin"
            class="btn-outline-warm min-h-11 px-5 py-3 rounded-xl text-sm font-semibold inline-flex items-center"
          >
            Masuk Manual
          </a>
        </div>
      </div>
    ) : (
      <div class="space-y-10">
        <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-5 pb-6 border-b border-[rgba(232,220,206,0.14)]">
          <div>
            <h1 class="font-display text-3xl sm:text-5xl font-bold uppercase leading-[0.98] text-[#f3efe9]">
              Konsol Operasional Akademi Creator
            </h1>
            <p class="text-sm text-[#b5aea4] mt-1">
              Data transaksi, katalog produk, kupon diskon, dan antrean diskusi mentor secara langsung dari basis data.
            </p>
          </div>

          <nav aria-label="Menu Konsol Admin" class="flex flex-wrap items-center gap-2">
            <a
              href="/admin"
              aria-current="page"
              class="min-h-11 px-4 py-2 rounded-lg text-xs font-bold bg-[#b84334] text-white border border-[#d66151] inline-flex items-center"
            >
              Ringkasan
            </a>
            <a
              href="/admin/products"
              class="btn-outline-warm min-h-11 px-4 py-2 rounded-lg text-xs font-semibold inline-flex items-center"
            >
              Katalog Produk ({productCount})
            </a>
            <a
              href="/admin/vouchers"
              class="btn-outline-warm min-h-11 px-4 py-2 rounded-lg text-xs font-semibold inline-flex items-center"
            >
              Kupon Promo ({voucherCount})
            </a>
            <a
              href="/admin/chat"
              class="btn-outline-warm min-h-11 px-4 py-2 rounded-lg text-xs font-semibold inline-flex items-center"
            >
              Meja Diskusi Mentor
            </a>
          </nav>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          <div class="rounded-2xl border border-[rgba(232,220,206,0.16)] bg-[#181614] p-5">
            <div class="text-xs text-[#9e968c] mb-1">Total Pendapatan Terbayar</div>
            <div class="num-tabular font-display text-3xl font-bold text-[#f3efe9]">
              {formatIDR(revenueRow.totalRevenue)}
            </div>
            <div class="num-tabular text-xs text-[#b5aea4] mt-1">{revenueRow.orderCount} faktur lunas</div>
          </div>

          <div class="rounded-2xl border border-[rgba(232,220,206,0.16)] bg-[#181614] p-5">
            <div class="text-xs text-[#9e968c] mb-1">Siswa Terdaftar</div>
            <div class="num-tabular font-display text-3xl font-bold text-[#f3efe9]">{studentCount}</div>
            <div class="text-xs text-[#b5aea4] mt-1">Akun belajar aktif</div>
          </div>

          <div class="rounded-2xl border border-[rgba(232,220,206,0.16)] bg-[#181614] p-5">
            <div class="text-xs text-[#9e968c] mb-1">Produk & Bundling Katalog</div>
            <div class="num-tabular font-display text-3xl font-bold text-[#f3efe9]">{productCount}</div>
            <div class="text-xs text-[#e87161] mt-1">
              <a href="/admin/products" class="hover:underline">Tambah produk baru</a>
            </div>
          </div>

          <div class="rounded-2xl border border-[rgba(232,220,206,0.16)] bg-[#181614] p-5">
            <div class="text-xs text-[#9e968c] mb-1">Kode Kupon Aktif</div>
            <div class="num-tabular font-display text-3xl font-bold text-[#f3efe9]">{voucherCount}</div>
            <div class="text-xs text-[#e87161] mt-1">
              <a href="/admin/vouchers" class="hover:underline">Kelola kuota kupon</a>
            </div>
          </div>
        </div>

        <div class="space-y-4">
          <div class="flex items-center justify-between">
            <h2 class="text-xl font-bold text-[#f3efe9]">Jurnal Transaksi Terbaru</h2>
            <span class="num-tabular text-xs text-[#9e968c]">{recentOrders.length} transaksi terakhir</span>
          </div>

          {recentOrders.length > 0 ? (
            <div class="overflow-x-auto rounded-2xl border border-[rgba(232,220,206,0.14)] bg-[#161412]">
              <table class="w-full text-left border-collapse text-sm">
                <thead>
                  <tr class="border-b border-[rgba(232,220,206,0.14)] text-xs uppercase tracking-wider text-[#9e968c]">
                    <th class="py-3.5 px-5 font-semibold">Referensi</th>
                    <th class="py-3.5 px-5 font-semibold">Siswa</th>
                    <th class="py-3.5 px-5 font-semibold">Program</th>
                    <th class="py-3.5 px-5 font-semibold">Kupon</th>
                    <th class="py-3.5 px-5 font-semibold text-right">Potongan</th>
                    <th class="py-3.5 px-5 font-semibold text-right">Total Bersih</th>
                    <th class="py-3.5 px-5 font-semibold text-right">Waktu</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-[rgba(232,220,206,0.1)]">
                  {recentOrders.map((ord) => (
                    <tr>
                      <td class="py-4 px-5 font-mono text-xs text-[#f3efe9] whitespace-nowrap">{ord.payment_reference}</td>
                      <td class="py-4 px-5">
                        <div class="font-semibold text-[#f3efe9]">{ord.buyer_name}</div>
                        <div class="text-xs text-[#9e968c]">{ord.buyer_email}</div>
                      </td>
                      <td class="py-4 px-5 text-[#e8e2da] max-w-xs truncate">{ord.product_title}</td>
                      <td class="py-4 px-5 font-mono text-xs text-[#e87161]">{ord.voucher_code || '-'}</td>
                      <td class="py-4 px-5 num-tabular text-xs text-[#b5aea4] text-right whitespace-nowrap">
                        {ord.discount > 0 ? `-${formatIDR(ord.discount)}` : 'Rp 0'}
                      </td>
                      <td class="py-4 px-5 num-tabular font-bold text-[#f3efe9] text-right whitespace-nowrap">
                        {formatIDR(ord.total)}
                      </td>
                      <td class="py-4 px-5 num-tabular text-xs text-[#9e968c] text-right whitespace-nowrap">
                        {formatDate(ord.created_at)}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          ) : (
            <div class="rounded-2xl border border-[rgba(232,220,206,0.14)] bg-[#161412] p-8 text-center text-sm text-[#b5aea4]">
              Belum ada transaksi tercatat di basis data.
            </div>
          )}
        </div>
      </div>
    )}
  </section>
</Layout>
