---
import Layout from '../../layouts/Layout.astro';
import { db } from '../../lib/db';
import { getUserFromSession } from '../../lib/auth';

const user = await getUserFromSession(Astro.cookies);
if (!user) {
  return Astro.redirect('/auth/login?redirect=/dashboard');
}

const enrollments = (await db
  .prepare(`
    SELECT e.*, p.title, p.slug, p.type, p.cover_image, p.tagline
    FROM enrollments e
    JOIN products p ON e.course_id = p.id
    WHERE e.user_id = ?
    ORDER BY e.created_at DESC
  `)
  .all(user.id)) as any[];

const enrichedEnrollments = await Promise.all(
  enrollments.map(async (enr) => {
    const lessons = (await db
      .prepare('SELECT id, title, module_title FROM lessons WHERE course_id = ? ORDER BY order_index ASC')
      .all(enr.course_id)) as any[];

    const completedRows = (await db
      .prepare(`
        SELECT ulp.lesson_id FROM user_lesson_progress ulp
        JOIN lessons l ON ulp.lesson_id = l.id
        WHERE ulp.user_id = ? AND l.course_id = ? AND ulp.completed = 1
      `)
      .all(user.id, enr.course_id)) as any[];

    const completedSet = new Set(completedRows.map((r) => r.lesson_id));
    const nextLesson = lessons.find((l) => !completedSet.has(l.id)) || lessons[0] || null;
    const fallbackCourseId = lessons.length > 0 ? enr.course_id : 'prod_course_100k';
    const fallbackLessonId = nextLesson?.id || 'les_100k_1';

    return {
      ...enr,
      totalLessons: lessons.length,
      completedCount: completedSet.size,
      nextLessonTitle: nextLesson?.title || 'Mulai Bab Pertama',
      resumeHref: `/classroom/${fallbackCourseId}/${fallbackLessonId}`,
    };
  })
);

const primaryCourse = enrichedEnrollments[0] || null;

const orders = (await db
  .prepare(`
    SELECT o.*, p.title as product_title
    FROM orders o
    JOIN products p ON o.product_id = p.id
    WHERE o.user_id = ?
    ORDER BY o.created_at DESC
  `)
  .all(user.id)) as any[];

const latestChat = (await db
  .prepare(`
    SELECT cm.message, cm.created_at, u.name as sender_name
    FROM chat_rooms cr
    JOIN chat_messages cm ON cm.room_id = cr.id
    JOIN users u ON cm.sender_id = u.id
    WHERE cr.student_id = ?
    ORDER BY cm.created_at DESC
    LIMIT 1
  `)
  .get(user.id)) as any;

const formatIDR = (val: number) =>
  new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', maximumFractionDigits: 0 }).format(val);

const formatDate = (iso: string) =>
  new Intl.DateTimeFormat('id-ID', { day: '2-digit', month: 'short', year: 'numeric' }).format(new Date(iso));
---

<Layout
  title="Member Area Siswa | Akademi Creator"
  description="Pantau progres kurikulum, lanjutkan materi terakhir, dan berdiskusi 1-on-1 bersama mentor."
  user={user}
>
  <section class="max-w-7xl mx-auto px-5 sm:px-8 py-10 lg:py-14 space-y-12">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 pb-6 border-b border-[rgba(232,220,206,0.14)]">
      <div>
        <h1 class="font-display text-3xl sm:text-5xl font-bold uppercase leading-[0.98] text-[#f3efe9]">
          Ruang Belajar {user.name}
        </h1>
        <p class="text-sm text-[#b5aea4] mt-1">
          Akun terdaftar: <span class="text-[#e8e2da]">{user.email}</span>
        </p>
      </div>
      <div class="flex flex-wrap items-center gap-2.5">
        <a
          href="/dashboard/chat"
          class="btn-outline-warm min-h-11 px-4 py-2.5 rounded-xl text-xs sm:text-sm font-semibold inline-flex items-center gap-2"
        >
          <span>Diskusi 1-on-1 Mentor</span>
        </a>
        <a
          href="/products"
          class="btn-outline-warm min-h-11 px-4 py-2.5 rounded-xl text-xs sm:text-sm font-semibold inline-flex items-center"
        >
          Tambah Program
        </a>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-stretch">
      <div class="lg:col-span-8 surface-bezel">
        <div class="surface-bezel-inner p-6 sm:p-8 h-full flex flex-col justify-between">
          {primaryCourse ? (
            <>
              <div>
                <div class="flex flex-wrap items-center justify-between gap-2 text-xs text-[#e87161] font-semibold uppercase tracking-wider mb-2">
                  <span>Lanjutkan Materi Terakhir</span>
                  <span class="num-tabular text-[#f3efe9]">{primaryCourse.progress}% Selesai</span>
                </div>
                <h2 class="text-xl sm:text-2xl font-bold text-[#f3efe9] leading-snug mb-2">
                  {primaryCourse.title}
                </h2>
                <p class="text-sm text-[#b5aea4] mb-5">
                  Bab berikutnya: <strong class="text-[#e8e2da]">{primaryCourse.nextLessonTitle}</strong>
                </p>

                <div class="w-full h-2 rounded-full bg-[#24201d] overflow-hidden mb-6">
                  <div
                    class="h-full bg-[#b84334] rounded-full transition-all"
                    style={`width: ${Math.max(4, primaryCourse.progress)}%`}
                  />
                </div>
              </div>

              <div class="flex flex-wrap items-center justify-between gap-4 pt-2">
                <span class="num-tabular text-xs text-[#9e968c]">
                  {primaryCourse.completedCount} dari {primaryCourse.totalLessons} bab diselesaikan
                </span>
                <a
                  href={primaryCourse.resumeHref}
                  class="btn-crimson min-h-11 px-6 py-3 rounded-xl text-sm font-bold inline-flex items-center gap-2"
                >
                  <span>Buka Ruang Kelas</span>
                  <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-6-6l6 6-6 6" />
                  </svg>
                </a>
              </div>
            </>
          ) : (
            <div class="py-4 space-y-4">
              <h2 class="text-xl sm:text-2xl font-bold text-[#f3efe9]">
                Belum Ada Kelas atau Buku yang Diaktifkan
              </h2>
              <p class="text-sm text-[#b5aea4] leading-relaxed max-w-xl">
                Pilih program akselerator 90 hari, e-book storytelling, atau paket Full-Stack Creatorpreneur untuk langsung membuka akses video materi dan lembar kerja di halaman ini.
              </p>
              <div class="pt-2">
                <a
                  href="/products"
                  class="btn-crimson min-h-11 px-6 py-3 rounded-xl text-sm font-bold inline-flex items-center gap-2"
                >
                  <span>Pilih Program di Katalog</span>
                </a>
              </div>
            </div>
          )}
        </div>
      </div>

      <aside class="lg:col-span-4 rounded-2xl border border-[rgba(232,220,206,0.16)] bg-[#181614] p-6 flex flex-col justify-between gap-5">
        <div>
          <div class="flex items-center gap-3.5 mb-4">
            <div class="w-12 h-12 rounded-xl overflow-hidden border border-[rgba(232,220,206,0.2)] shrink-0 bg-[#121110]">
              <img
                src="/acre/mentors/ogut.webp"
                alt="Aldio Ogut"
                width="96"
                height="96"
                class="w-full h-full object-cover object-[58%_22%] scale-[1.06]"
              />
            </div>
            <div>
              <div class="text-sm font-bold text-[#f3efe9]">Aldio Ogut</div>
              <div class="text-xs text-[#e87161]">Founder & Head Mentor</div>
            </div>
          </div>

          <div class="rounded-xl border border-[rgba(232,220,206,0.12)] bg-[#121110] p-4 text-xs text-[#e8e2da] leading-relaxed">
            {latestChat ? (
              <>
                <div class="text-[11px] text-[#9e968c] mb-1">Pesan terakhir dari {latestChat.sender_name}:</div>
                <p class="line-clamp-3">"{latestChat.message}"</p>
              </>
            ) : (
              <p>Kirim draf naskah pembuka atau tautan akun Anda untuk dievaluasi langsung di ruang konsultasi privat.</p>
            )}
          </div>
        </div>

        <a
          href="/dashboard/chat"
          class="btn-outline-warm min-h-11 w-full px-4 py-2.5 rounded-xl text-xs sm:text-sm font-semibold inline-flex items-center justify-center"
        >
          Buka Ruang Diskusi 1-on-1
        </a>
      </aside>
    </div>

    {
      enrichedEnrollments.length > 0 && (
        <div class="space-y-5">
          <h2 class="text-xl sm:text-2xl font-bold text-[#f3efe9]">Program & Pustaka Aktif Anda</h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            {enrichedEnrollments.map((item) => (
              <article class="surface-atelier rounded-2xl p-5 sm:p-6 flex flex-col justify-between gap-5">
                <div class="flex items-start gap-4">
                  <img
                    src={item.cover_image || '/acre/curriculum/fast-track.webp'}
                    alt={item.title}
                    width="135"
                    height="242"
                    loading="lazy"
                    decoding="async"
                    class="w-16 aspect-[9/16] rounded-xl object-contain p-1 border border-[rgba(232,220,206,0.16)] shrink-0 bg-[#141210]"
                  />
                  <div class="min-w-0 flex-1">
                    <span class="text-[11px] uppercase tracking-wider font-semibold text-[#e87161]">
                      {item.type === 'book' ? 'E-Book & Panduan' : 'Kelas Intensif'}
                    </span>
                    <h3 class="text-base sm:text-lg font-bold text-[#f3efe9] leading-snug mt-0.5 mb-2">
                      {item.title}
                    </h3>
                    <div class="flex items-center justify-between text-xs text-[#9e968c] mb-1.5">
                      <span>Progres penyelesaian</span>
                      <span class="num-tabular font-semibold text-[#f3efe9]">{item.progress}%</span>
                    </div>
                    <div class="w-full h-1.5 rounded-full bg-[#24201d] overflow-hidden">
                      <div class="h-full bg-[#b84334] rounded-full" style={`width: ${Math.max(4, item.progress)}%`} />
                    </div>
                  </div>
                </div>

                <div class="flex items-center justify-between pt-4 border-t border-[rgba(232,220,206,0.1)]">
                  <span class="num-tabular text-xs text-[#9e968c]">
                    {item.completedCount}/{item.totalLessons} bab selesai
                  </span>
                  <a
                    href={item.resumeHref}
                    class="btn-outline-warm min-h-11 px-4 rounded-xl text-xs font-semibold inline-flex items-center"
                  >
                    Pelajari Materi
                  </a>
                </div>
              </article>
            ))}
          </div>
        </div>
      )
    }

    <div class="space-y-4">
      <h2 class="text-xl sm:text-2xl font-bold text-[#f3efe9]">Riwayat Tagihan & Pembelian</h2>
      {orders.length > 0 ? (
        <div class="overflow-x-auto rounded-2xl border border-[rgba(232,220,206,0.14)] bg-[#161412]">
          <table class="w-full text-left border-collapse text-sm">
            <thead>
              <tr class="border-b border-[rgba(232,220,206,0.14)] text-xs uppercase tracking-wider text-[#9e968c]">
                <th class="py-3.5 px-5 font-semibold">No. Referensi</th>
                <th class="py-3.5 px-5 font-semibold">Program</th>
                <th class="py-3.5 px-5 font-semibold">Metode</th>
                <th class="py-3.5 px-5 font-semibold">Tanggal</th>
                <th class="py-3.5 px-5 font-semibold text-right">Total Bayar</th>
                <th class="py-3.5 px-5 font-semibold text-right">Status</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-[rgba(232,220,206,0.1)]">
              {orders.map((ord) => (
                <tr>
                  <td class="py-4 px-5 font-mono text-xs text-[#f3efe9] whitespace-nowrap">{ord.payment_reference}</td>
                  <td class="py-4 px-5 text-[#e8e2da] max-w-xs truncate">{ord.product_title}</td>
                  <td class="py-4 px-5 text-xs uppercase text-[#b5aea4] whitespace-nowrap">{ord.payment_method}</td>
                  <td class="py-4 px-5 num-tabular text-xs text-[#b5aea4] whitespace-nowrap">{formatDate(ord.created_at)}</td>
                  <td class="py-4 px-5 num-tabular font-bold text-[#f3efe9] text-right whitespace-nowrap">{formatIDR(ord.total)}</td>
                  <td class="py-4 px-5 text-right whitespace-nowrap">
                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded bg-[#1d2c22] border border-[#3d6b4c] text-[11px] font-bold text-[#a7f3d0]">
                      <span>LUNAS</span>
                    </span>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      ) : (
        <div class="rounded-2xl border border-[rgba(232,220,206,0.14)] bg-[#161412] p-6 text-sm text-[#b5aea4]">
          Belum ada catatan transaksi pada akun ini.
        </div>
      )}
    </div>
  </section>
</Layout>
