---
import Layout from '../../layouts/Layout.astro';
import { getUserFromSession } from '../../lib/auth';

const user = await getUserFromSession(Astro.cookies);
if (user) {
  return Astro.redirect(user.role === 'admin' ? '/admin' : '/dashboard');
}

const redirectParam = Astro.url.searchParams.get('redirect') || '';
---

<Layout
  title="Masuk ke Member Area | Akademi Creator"
  description="Akses kurikulum video 90 hari, e-book interaktif, dan ruang konsultasi 1-on-1 bersama mentor Akademi Creator."
>
  <section class="max-w-5xl mx-auto px-5 sm:px-8 py-12 lg:py-20">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">
      <div class="lg:col-span-7 surface-bezel">
        <div class="surface-bezel-inner p-6 sm:p-9">
          <h1 class="font-display text-3xl sm:text-4xl font-bold uppercase text-[#f3efe9] mb-2">
            Masuk ke Ruang Belajar Anda
          </h1>
          <p class="text-sm text-[#b5aea4] mb-7">
            Lanjutkan progres bab terakhir, evaluasi kuis, dan diskusi privat bersama mentor.
          </p>

          <form id="login-form" class="space-y-4" data-redirect={redirectParam} novalidate>
            <div>
              <label for="login-email" class="block text-xs font-semibold text-[#e8e2da] mb-1.5">
                Alamat Email Terdaftar
              </label>
              <input
                type="email"
                id="login-email"
                required
                autocomplete="email"
                placeholder="nama@email.com"
                class="input-warm w-full min-h-11 px-4 py-2.5 text-sm"
              />
            </div>

            <div>
              <label for="login-password" class="block text-xs font-semibold text-[#e8e2da] mb-1.5">
                Kata Sandi
              </label>
              <input
                type="password"
                id="login-password"
                required
                autocomplete="current-password"
                placeholder="Masukkan kata sandi"
                class="input-warm w-full min-h-11 px-4 py-2.5 text-sm"
              />
            </div>

            <div
              id="login-error"
              role="alert"
              class="hidden p-3.5 rounded-xl bg-[#301513] border border-[#e87161] text-xs text-[#f3efe9]"
            >
            </div>

            <button
              type="submit"
              id="login-submit"
              class="btn-crimson min-h-12 w-full px-6 py-3 rounded-xl font-bold text-sm"
            >
              Masuk ke Akun
            </button>
          </form>

          <p class="mt-6 pt-5 border-t border-[rgba(232,220,206,0.12)] text-xs sm:text-sm text-[#b5aea4]">
            Belum memiliki akun siswa?{' '}
            <a href="/auth/register" class="font-semibold text-[#e87161] hover:underline">
              Daftar akun baru di sini
            </a>
          </p>
        </div>
      </div>

      <aside class="lg:col-span-5 rounded-2xl border border-[rgba(232,220,206,0.16)] bg-[#181614] p-6 sm:p-7 space-y-5">
        <div>
          <h2 class="text-base font-bold text-[#f3efe9] mb-1">Akses Pratinjau Instan (1-Klik)</h2>
          <p class="text-xs sm:text-sm text-[#b5aea4] leading-relaxed">
            Gunakan sesi pratinjau resmi di bawah ini untuk menguji ruang kelas siswa, ruang balasan Head Mentor, atau konsol operasional Admin.
          </p>
        </div>

        <div class="space-y-3">
          <a
            href="/api/auth/demo?role=student"
            class="btn-outline-warm min-h-12 w-full px-4 py-3 rounded-xl flex items-center justify-between text-left"
          >
            <div>
              <div class="text-sm font-bold text-[#f3efe9]">Masuk sebagai Siswa Aktif</div>
              <div class="text-xs text-[#9e968c]">Fadli Pratama (Kelas 100K & E-Book Aktif)</div>
            </div>
            <span class="text-xs font-semibold text-[#e87161]">Buka</span>
          </a>

          <a
            href="/api/auth/demo?role=mentor"
            class="btn-outline-warm min-h-12 w-full px-4 py-3 rounded-xl flex items-center justify-between text-left"
          >
            <div>
              <div class="text-sm font-bold text-[#f3efe9]">Masuk sebagai Head Mentor</div>
              <div class="text-xs text-[#9e968c]">Aldio Ogut (Meja Diskusi 1-on-1 Siswa)</div>
            </div>
            <span class="text-xs font-semibold text-[#e87161]">Buka</span>
          </a>

          <a
            href="/api/auth/demo?role=admin"
            class="btn-outline-warm min-h-12 w-full px-4 py-3 rounded-xl flex items-center justify-between text-left"
          >
            <div>
              <div class="text-sm font-bold text-[#f3efe9]">Masuk sebagai Admin Operasional</div>
              <div class="text-xs text-[#9e968c]">Kelola Produk, Kupon Promo & Transaksi</div>
            </div>
            <span class="text-xs font-semibold text-[#e87161]">Buka</span>
          </a>
        </div>
      </aside>
    </div>
  </section>
</Layout>

<script>
  const form = document.getElementById('login-form') as HTMLFormElement | null;
  const errorBox = document.getElementById('login-error');
  const submitBtn = document.getElementById('login-submit') as HTMLButtonElement | null;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorBox?.classList.add('hidden');

    const email = (document.getElementById('login-email') as HTMLInputElement)?.value?.trim();
    const password = (document.getElementById('login-password') as HTMLInputElement)?.value || '';
    const customRedirect = form.dataset.redirect || '';

    if (!email || !password) {
      if (errorBox) {
        errorBox.textContent = 'Mohon isi alamat email dan kata sandi Anda.';
        errorBox.classList.remove('hidden');
      }
      return;
    }

    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.textContent = 'Memverifikasi Akun...';
    }

    try {
      const res = await fetch('/api/auth/login', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email, password }),
      });
      const data = await res.json();

      if (data.success) {
        const nextUrl =
          customRedirect && customRedirect.startsWith('/') && !customRedirect.startsWith('//')
            ? customRedirect
            : data.redirectUrl || '/dashboard';
        window.location.href = nextUrl;
        return;
      }

      if (errorBox) {
        errorBox.textContent = data.message || 'Email atau kata sandi tidak sesuai.';
        errorBox.classList.remove('hidden');
      }
    } catch {
      if (errorBox) {
        errorBox.textContent = 'Terjadi gangguan jaringan. Silakan coba kembali.';
        errorBox.classList.remove('hidden');
      }
    } finally {
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Masuk ke Akun';
      }
    }
  });
</script>
