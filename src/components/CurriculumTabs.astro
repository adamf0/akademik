<script is:inline>
  (() => {
    const triggers = Array.from(document.querySelectorAll('[data-curr-trigger]'));
    const panels = Array.from(document.querySelectorAll('[data-curr-panel]'));
    if (!triggers.length) return;

    function activate(id, moveFocus = false) {
      triggers.forEach((btn) => {
        const active = btn.getAttribute('data-curr-trigger') === id;
        btn.setAttribute('aria-selected', active ? 'true' : 'false');
        btn.classList.toggle('border-[#e87161]', active);
        btn.classList.toggle('bg-[#201a18]', active);
        btn.classList.toggle('text-[#f3efe9]', active);
        btn.classList.toggle('border-[#e8dcce]/12', !active);
        btn.classList.toggle('bg-[#161412]', !active);
        btn.classList.toggle('text-[#b5aea4]', !active);
        if (active && moveFocus) btn.focus();
      });
      panels.forEach((panel) => {
        panel.classList.toggle('hidden', panel.getAttribute('data-curr-panel') !== id);
      });
    }

    triggers.forEach((btn, idx) => {
      btn.addEventListener('click', () => activate(btn.getAttribute('data-curr-trigger')));
      btn.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowDown' || e.key === 'ArrowRight') {
          e.preventDefault();
          const next = triggers[(idx + 1) % triggers.length];
          activate(next.getAttribute('data-curr-trigger'), true);
        } else if (e.key === 'ArrowUp' || e.key === 'ArrowLeft') {
          e.preventDefault();
          const prev = triggers[(idx - 1 + triggers.length) % triggers.length];
          activate(prev.getAttribute('data-curr-trigger'), true);
        }
      });
    });
  })();
</script>
