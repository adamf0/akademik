---
const stageMentors = [
  {
    id: 'aldio',
    num: '01',
    name: 'Aldio Ogut',
    role: 'Founder & Head Mentor',
    specialty: 'Psikologi perilaku manusia & bisnis produk digital',
    img: '/acre/hero/aldio-color.webp',
    width: 618,
    height: 600,
    posClass: 'left-[-1.5%] bottom-0 z-20 w-[55%]',
    hitClass: 'left-0 bottom-0 z-30 h-1/2 w-1/2',
    auraPos: 'left: 8%; top: 38%;',
    priority: true,
  },
  {
    id: 'shifa',
    num: '02',
    name: 'Shifa Kelana',
    role: 'Head Mentor Storytelling',
    specialty: 'Narasi personal brand & penguatan kepercayaan audiens',
    img: '/acre/hero/shifa-color.webp',
    width: 614,
    height: 665,
    posClass: 'left-[5%] top-[1%] z-10 w-[52%]',
    hitClass: 'left-0 top-0 z-30 h-1/2 w-1/2',
    auraPos: 'left: 16%; top: 8%;',
    priority: false,
  },
  {
    id: 'aries',
    num: '03',
    name: 'Aries Bachri',
    role: 'Head Mentor Growth',
    specialty: 'Rekayasa retensi video & replikasi akun 100K+',
    img: '/acre/hero/aries-color.webp',
    width: 927,
    height: 927,
    posClass: 'right-[-3%] bottom-0 z-20 w-[64%]',
    hitClass: 'right-0 bottom-0 z-30 h-1/2 w-1/2',
    auraPos: 'left: 44%; top: 38%;',
    priority: false,
  },
  {
    id: 'dea',
    num: '04',
    name: 'Aldela Gunadi',
    role: 'Media Lead Akademi Creator',
    specialty: 'Standar editorial korporasi & distribusi multi-kanal',
    img: '/acre/hero/dea-color.webp',
    width: 491,
    height: 873,
    posClass: 'right-0 top-0 z-10 w-[42%]',
    hitClass: 'right-0 top-0 z-30 h-1/2 w-1/2',
    auraPos: 'left: 48%; top: 8%;',
    priority: false,
  },
];
---

<section class="relative overflow-hidden border-b border-[#e8dcce]/12 bg-[#121110]">
  <div class="mx-auto max-w-[1360px] px-5 pt-8 pb-16 sm:px-8 md:pt-12 md:pb-20 lg:px-12 lg:pt-14 lg:pb-22">
    <div class="grid grid-cols-1 items-center gap-10 lg:grid-cols-12 lg:gap-8">
      <div class="lg:col-span-6 space-y-7">
        <h1 class="font-display text-[clamp(3.1rem,7vw,5.45rem)] font-extrabold uppercase leading-[0.95] tracking-tight text-[#f3efe9]">
          JADI <span class="text-[#e87161]">CREATORPRENEUR</span> <br />
          0 KE 100K DALAM 90 HARI.
        </h1>

        <p class="max-w-[54ch] text-[17px] sm:text-[19px] leading-[1.62] text-[#e8e2da]">
          Bangun <span class="font-semibold text-[#f3efe9]">personal brand</span>, monetisasi pengaruh, dan rancang bisnis produk digital dari nol. Kejar <span class="font-semibold text-[#e87161]">kebebasan waktu</span> serta <span class="font-semibold text-[#e87161]">kebebasan tempat</span> bersama mentor praktisi yang konsisten membimbing sejak 2019.
        </p>

        <div class="flex flex-col sm:flex-row sm:items-center gap-3.5 pt-1">
          <a
            href="#paket"
            class="btn-crimson inline-flex min-h-[52px] items-center justify-center rounded-xl px-7 text-[15px] font-semibold tracking-wide"
          >
            Pilih Program Belajar
          </a>
          <a
            href="/classroom/prod_course_100k/les_100k_1"
            class="btn-outline-warm inline-flex min-h-[52px] items-center justify-center gap-2.5 rounded-xl px-6 text-[15px] font-semibold"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round" aria-hidden="true">
              <polygon points="6 4 20 12 6 20 6 4" />
            </svg>
            <span>Tonton Sampel Kelas LMS</span>
          </a>
        </div>

        <dl class="grid grid-cols-3 gap-2.5 sm:gap-4 border-t border-[#e8dcce]/14 pt-7 num-tabular">
          <div>
            <dt class="text-[11px] sm:text-[12px] font-medium text-[#9e968c]">Rekam Jejak</dt>
            <dd class="mt-1 font-display text-[22px] sm:text-[30px] lg:text-[32px] font-bold uppercase leading-none text-[#f3efe9]">Sejak 2019</dd>
          </div>
          <div class="border-l border-[#e8dcce]/12 pl-2.5 sm:pl-4">
            <dt class="text-[11px] sm:text-[12px] font-medium text-[#9e968c]">Materi Member Area</dt>
            <dd class="mt-1 font-display text-[22px] sm:text-[30px] lg:text-[32px] font-bold uppercase leading-none text-[#f3efe9]">500+ Video</dd>
          </div>
          <div class="border-l border-[#e8dcce]/12 pl-2.5 sm:pl-4">
            <dt class="text-[11px] sm:text-[12px] font-medium text-[#9e968c]">Jalur Kompetensi</dt>
            <dd class="mt-1 font-display text-[22px] sm:text-[30px] lg:text-[32px] font-bold uppercase leading-none text-[#e87161]">9 Kurikulum</dd>
          </div>
        </dl>
      </div>

      <div class="lg:col-span-6">
        <div class="mx-auto max-w-[640px]">
          <div
            id="hero-cutout-stage"
            class="relative aspect-[32/31] w-full overflow-hidden select-none bg-[#121110]"
          >
            <div
              id="hero-stage-aura"
              aria-hidden="true"
              style="left: 8%; top: 38%;"
              class="pointer-events-none absolute z-0 h-[50%] w-[46%] rounded-full bg-[radial-gradient(circle,rgba(184,67,52,0.34)_0%,rgba(184,67,52,0.08)_46%,transparent_70%)] blur-xl transition-all duration-500 ease-[cubic-bezier(0.22,1,0.36,1)]"
            ></div>

            {stageMentors.map((m, idx) => (
              <img
                src={m.img}
                alt={`${m.name}, ${m.role} Akademi Creator`}
                width={m.width}
                height={m.height}
                fetchpriority={m.priority ? 'high' : 'auto'}
                decoding="async"
                data-hero-figure={m.id}
                data-aura={m.auraPos}
                class:list={[
                  'pointer-events-none absolute h-auto origin-bottom object-contain opacity-100 transition-all duration-500 ease-[cubic-bezier(0.22,1,0.36,1)]',
                  m.posClass,
                  idx === 0
                    ? 'scale-[1.015] grayscale-0 brightness-[1.04] contrast-[1.03] drop-shadow-[0_18px_36px_rgba(0,0,0,0.75)]'
                    : 'scale-100 grayscale brightness-[0.76] contrast-[1.08]',
                ]}
              />
            ))}

            {stageMentors.map((m) => (
              <div
                aria-hidden="true"
                data-hero-hit={m.id}
                data-aura={m.auraPos}
                title={`${m.name} (${m.role})`}
                class={`absolute cursor-pointer ${m.hitClass}`}
              ></div>
            ))}

            <div
              aria-hidden="true"
              class="pointer-events-none absolute inset-x-0 bottom-0 z-[25] h-[24%] bg-gradient-to-t from-[#121110] via-[#121110]/85 to-transparent"
            ></div>
            <div
              aria-hidden="true"
              class="pointer-events-none absolute inset-y-0 left-0 z-[25] w-6 bg-gradient-to-r from-[#121110] to-transparent"
            ></div>
            <div
              aria-hidden="true"
              class="pointer-events-none absolute inset-y-0 right-0 z-[25] w-6 bg-gradient-to-l from-[#121110] to-transparent"
            ></div>
          </div>

        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    const figures = Array.from(document.querySelectorAll('[data-hero-figure]'));
    const hits = Array.from(document.querySelectorAll('[data-hero-hit]'));
    const aura = document.getElementById('hero-stage-aura');
    if (!figures.length) return;

    function spotlight(id) {
      figures.forEach((fig) => {
        const active = fig.getAttribute('data-hero-figure') === id;
        fig.classList.toggle('scale-[1.015]', active);
        fig.classList.toggle('grayscale-0', active);
        fig.classList.toggle('brightness-[1.04]', active);
        fig.classList.toggle('contrast-[1.03]', active);
        fig.classList.toggle('drop-shadow-[0_18px_36px_rgba(0,0,0,0.75)]', active);

        fig.classList.toggle('scale-100', !active);
        fig.classList.toggle('grayscale', !active);
        fig.classList.toggle('brightness-[0.76]', !active);
        fig.classList.toggle('contrast-[1.08]', !active);

        fig.style.zIndex = active ? '22' : '';

        if (active && aura) {
          const auraStyle = fig.getAttribute('data-aura');
          if (auraStyle) aura.setAttribute('style', auraStyle);
        }
      });
    }

    hits.forEach((hit) => {
      const id = hit.getAttribute('data-hero-hit');
      hit.addEventListener('mouseenter', () => spotlight(id));
      hit.addEventListener('click', () => spotlight(id));
    });
  })();
</script>
