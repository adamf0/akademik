          <div
            aria-hidden="true"
            class="pointer-events-none absolute inset-y-0 left-0 z-[42] w-8 sm:w-20 lg:w-32 bg-gradient-to-r from-[#141210] via-[#141210]/70 to-transparent"
          />
          <div
            aria-hidden="true"
            class="pointer-events-none absolute inset-y-0 right-0 z-[42] w-8 sm:w-20 lg:w-32 bg-gradient-to-l from-[#141210] via-[#141210]/70 to-transparent"
          />
          <div
            aria-hidden="true"
            class="pointer-events-none absolute inset-x-0 bottom-0 z-[42] h-20 sm:h-24 bg-gradient-to-t from-[#141210] via-[#141210]/80 to-transparent"
          />

          {
            socialProfiles.map((prof, idx) => (
              <button
                type="button"
                data-social-card={idx}
                data-niche={prof.niche}
                data-name={prof.name}
                data-handle={prof.handle}
                data-platform={prof.platform}
                data-role={prof.role}
                data-followers={prof.followers}
                data-reach={prof.reach}
                aria-label={`Fokuskan profil ${prof.name}, ${prof.role}, ${prof.followers}`}
                aria-current={idx === 0 ? 'true' : 'false'}
                tabindex={idx <= 3 || idx >= socialProfiles.length - 3 ? 0 : -1}
                style={getInitialFanStyle(idx, socialProfiles.length)}
                class="social-fan-card absolute w-[204px] sm:w-[232px] lg:w-[258px] aspect-[270/532] rounded-[18px] origin-bottom focus-visible:outline-2 focus-visible:outline-[#f08a7b] focus-visible:outline-offset-4"
              >
                <img
                  src={prof.image}
                  alt={`Tangkapan layar profil ${prof.platform} ${prof.name} (${prof.handle})`}
                  width="270"
                  height="532"
                  loading="lazy"
                  decoding="async"
                  draggable="false"
                  class="w-full h-full rounded-[18px] object-contain pointer-events-none ring-1 ring-white/15"
                />
              </button>
            ))
          }
        </div>

        <button
          type="button"
          id="social-fan-prev"
          aria-label="Profil anggota sebelumnya"
          class="btn-crimson absolute left-1 sm:left-3 lg:left-5 top-1/2 -translate-y-1/2 z-[55] w-11 h-11 sm:w-12 sm:h-12 rounded-full inline-flex items-center justify-center"
        >
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
          </svg>
        </button>

        <button
          type="button"
          id="social-fan-next"
          aria-label="Profil anggota berikutnya"
          class="btn-crimson absolute right-1 sm:right-3 lg:right-5 top-1/2 -translate-y-1/2 z-[55] w-11 h-11 sm:w-12 sm:h-12 rounded-full inline-flex items-center justify-center"
        >
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
        </button>
      </div>

      <div
        aria-live="polite"
        class="mx-auto mt-3 max-w-[680px] rounded-2xl border border-[rgba(232,220,206,0.16)] bg-[#191715] px-5 py-4 sm:px-6 sm:py-5 shadow-[0_18px_38px_rgba(0,0,0,0.4)]"
      >
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
          <div class="min-w-0">
            <div class="flex flex-wrap items-center gap-2 text-xs sm:text-[13px] text-[#b5aea4]">
              <span
                id="social-readout-index"
                class="num-tabular inline-flex items-center rounded-md bg-[#25211e] border border-[#736b63] px-2 py-0.5 font-semibold text-[#f3efe9]"
              >
                01 / 13
              </span>
              <span id="social-readout-handle" class="font-semibold text-[#e87161]">
                Instagram · @dimasgepeto
              </span>
              <span aria-hidden="true" class="text-[#736b63]">/</span>
              <span id="social-readout-role" class="text-[#e8e2da]">Woodworking &amp; DIY</span>
            </div>
            <h3
              id="social-readout-name"
              class="mt-1.5 font-display text-2xl sm:text-3xl font-bold uppercase tracking-tight text-[#f3efe9]"
            >
              Dimas Gepeto
            </h3>
          </div>

          <div class="sm:text-right shrink-0 border-t sm:border-t-0 pt-3 sm:pt-0 border-[rgba(232,220,206,0.1)]">
            <div id="social-readout-followers" class="num-tabular text-lg sm:text-xl font-bold text-[#f3efe9]">
              762K Pengikut
            </div>
            <div id="social-readout-reach" class="num-tabular text-xs sm:text-[13px] text-[#b5aea4] mt-0.5">
              5,4 Jt Tayangan / 30 Hari
            </div>
          </div>
        </div>

        <div aria-hidden="true" class="mt-4 h-1.5 w-full rounded-full bg-[#262320] overflow-hidden">
          <div
            id="social-readout-progress"
            class="h-full rounded-full bg-[#e87161] transition-[width] duration-300 ease-out"
            style="width: 7.7%;"
          />
        </div>
      </div>
    </div>
  </div>

  <div id="ulasan-member" class="border-t border-[rgba(232,220,206,0.12)] bg-[#121110]">
    <div class="mx-auto max-w-[1360px] px-5 sm:px-8 lg:px-12 py-20 lg:py-28" data-reveal>
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-end mb-8 sm:mb-10">
        <div class="lg:col-span-7">
          <h2 class="font-display text-4xl sm:text-5xl lg:text-[3.4rem] font-bold uppercase leading-[0.98] text-[#f3efe9]">
            Suara Anggota Komunitas Sejak 2019 dari <span class="text-[#e87161]">Berbagai Profesi</span>
          </h2>
        </div>
        <div class="lg:col-span-5">
          <p class="text-[15px] sm:text-base text-[#b5aea4] leading-relaxed">
            Ulasan langsung anggota aktif mengenai kedalaman kurikulum video, diskusi harian sesama kreator, pemanfaatan AI, hingga sesi live rutin dan pendampingan pasca-kelas.
          </p>
        </div>
      </div>

      <div
        role="group"
        aria-label="Saring topik ulasan anggota"
        class="flex flex-wrap items-center gap-2 sm:gap-2.5 mb-8 lg:mb-10"
      >
        {
          testimonyFilters.map((filter, idx) => (
            <button
              type="button"
              data-testimony-filter={filter.id}
              aria-pressed={idx === 0 ? 'true' : 'false'}
              class:list={[
                'min-h-11 px-4 py-2 rounded-lg text-xs sm:text-sm font-semibold border transition-colors',
                idx === 0
                  ? 'bg-[#f3efe9] text-[#121110] border-[#f3efe9]'
                  : 'bg-[#181614] text-[#b5aea4] border-[#736b63] hover:text-[#f3efe9] hover:border-[#a89f95]',
              ]}
            >
              {filter.label}
            </button>
          ))
        }
      </div>

      <div
        id="testimony-wall"
        class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-7 items-start lg:pb-7"
      >
        {
          testimonyCards.map((card, idx) => (
            <article
              data-testimony-card={card.id}
              data-category={card.category}
              data-featured={card.featured ? 'true' : 'false'}
              class:list={[
                'rounded-2xl bg-[#ece7df] text-[#121110] p-7 sm:p-8 shadow-[0_18px_40px_rgba(0,0,0,0.44)] transition-transform duration-200 hover:-translate-y-1 flex flex-col justify-between',
                card.featured ? '' : 'hidden',
                card.featured && idx % 3 === 1 ? 'lg:translate-y-7' : '',
              ]}
            >
              <p class="text-[17px] sm:text-[18px] leading-[1.52] text-[#171513] font-normal">
                {card.quote}
              </p>

              <footer class="mt-7 pt-5 border-t border-[#d4cabd] flex items-center gap-4">
                <div class="w-14 h-14 rounded-full overflow-hidden shrink-0 bg-[#dad0c3]">
                  <img
                    src={card.avatar}
                    alt={`Foto profil ${card.name}`}
                    width="112"
                    height="112"
                    loading="lazy"
                    decoding="async"
                    class="w-full h-full object-cover scale-[1.06]"
                  />
                </div>
                <div class="min-w-0">
                  <h3 class="font-display text-[26px] sm:text-[28px] font-bold leading-[0.96] text-[#121110]">
                    {card.name}
                  </h3>
                  <p class="mt-1.5 text-[13px] font-medium text-[#544c44] leading-snug">
                    {card.context}
                  </p>
                </div>
              </footer>
            </article>
          ))
        }
      </div>

      <div id="testimony-toggle-wrap" class="mt-10 sm:mt-12 flex justify-center">
        <button
          type="button"
          id="testimony-expand-btn"
          aria-expanded="false"
          class="btn-outline-warm min-h-11 px-6 py-3 rounded-xl text-sm font-semibold inline-flex items-center gap-2.5"
        >
          <span id="testimony-expand-label">Tampilkan 6 Ulasan Anggota Lainnya (Total 12)</span>
          <svg
            id="testimony-expand-icon"
            class="w-4 h-4 transition-transform duration-200"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
          </svg>
        </button>
      </div>
    </div>
  </div>
</section>

<style>
  .social-fan-card {
    transition:
      transform 420ms cubic-bezier(0.22, 1, 0.36, 1),
      opacity 320ms cubic-bezier(0.22, 1, 0.36, 1),
      filter 360ms cubic-bezier(0.22, 1, 0.36, 1);
    will-change: transform, opacity, filter;
  }

  @media (prefers-reduced-motion: reduce) {
    .social-fan-card {
      transition: none !important;
    }
  }
</style>

<script>
  (() => {
    const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-alumni-tab]'));
    const panels = Array.from(document.querySelectorAll<HTMLElement>('[data-alumni-panel]'));
    const prevBtn = document.getElementById('alumni-prev');
    const nextBtn = document.getElementById('alumni-next');

    if (tabs.length && panels.length) {
      let activeIndex = 0;

      const setActiveAlumni = (nextIdx: number, moveFocus = false) => {
        activeIndex = (nextIdx + tabs.length) % tabs.length;
        tabs.forEach((btn, idx) => {
          const selected = idx === activeIndex;
          btn.setAttribute('aria-selected', selected ? 'true' : 'false');
          btn.classList.toggle('bg-[#b84334]', selected);
          btn.classList.toggle('text-white', selected);
          btn.classList.toggle('border-[#d66151]', selected);
          btn.classList.toggle('bg-[#181614]', !selected);
          btn.classList.toggle('text-[#b5aea4]', !selected);
          btn.classList.toggle('border-[#736b63]', !selected);
          if (selected && moveFocus) btn.focus();
        });

        panels.forEach((panel, idx) => {
          panel.classList.toggle('hidden', idx !== activeIndex);
          panel.classList.toggle('block', idx === activeIndex);
        });

        const activePanel = panels[activeIndex];
        if (activePanel?.querySelector('[data-counter-price]')) {
          document.dispatchEvent(
            new CustomEvent('acre:trigger-counter', {
              detail: { target: `#${activePanel.id} [data-counter-price]` },
            })
          );
        }
      };

      tabs.forEach((btn, idx) => {
        btn.addEventListener('click', () => setActiveAlumni(idx));
        btn.addEventListener('keydown', (e) => {
          if (e.key === 'ArrowRight') {
            e.preventDefault();
            setActiveAlumni(idx + 1, true);
          } else if (e.key === 'ArrowLeft') {
            e.preventDefault();
            setActiveAlumni(idx - 1, true);
          }
        });
      });

      prevBtn?.addEventListener('click', () => setActiveAlumni(activeIndex - 1));
      nextBtn?.addEventListener('click', () => setActiveAlumni(activeIndex + 1));
    }

    const fanCards = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-social-card]'));
    const nicheBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-social-niche]'));
    const fanStage = document.getElementById('social-fan-stage');
    const fanRegion = document.getElementById('social-fan-region');
    const fanPrev = document.getElementById('social-fan-prev');
    const fanNext = document.getElementById('social-fan-next');
    const readoutIdx = document.getElementById('social-readout-index');
    const readoutHandle = document.getElementById('social-readout-handle');
    const readoutRole = document.getElementById('social-readout-role');
    const readoutName = document.getElementById('social-readout-name');
    const readoutFollowers = document.getElementById('social-readout-followers');
    const readoutReach = document.getElementById('social-readout-reach');
    const readoutProgress = document.getElementById('social-readout-progress');

    if (fanCards.length) {
      let currentNiche = 'all';
      let activePoolPos = 0;

      const getPool = () =>
        currentNiche === 'all'
          ? fanCards
          : fanCards.filter((card) => card.dataset.niche === currentNiche);

      const renderFan = () => {
        const pool = getPool();
        const total = pool.length;
        if (!total) return;

        activePoolPos = ((activePoolPos % total) + total) % total;
        const vw = window.innerWidth;
        const viewportCap = vw < 640 ? 1 : vw < 1024 ? 2 : 3;
        const maxVisible = Math.min(viewportCap, Math.floor((total - 1) / 2));
        const stepX = vw < 640 ? 86 : vw < 1024 ? 116 : 136;
        const stepRot = vw < 640 ? 9 : vw < 1024 ? 10 : 10.5;
        const centerLift = vw < 640 ? -4 : -8;
        const centerScale = vw < 640 ? 1.04 : 1.06;

        const poolSet = new Set(pool);

        fanCards.forEach((card) => {
          if (!poolSet.has(card)) {
            card.style.transform = 'translate3d(0px, 120px, 0) scale(0.6)';
            card.style.opacity = '0';
            card.style.pointerEvents = 'none';
            card.style.zIndex = '1';
            card.tabIndex = -1;
            card.setAttribute('aria-current', 'false');
            card.setAttribute('aria-hidden', 'true');
          }
        });

        pool.forEach((card, pos) => {
          let d = pos - activePoolPos;
          if (d > total / 2) d -= total;
          if (d < -total / 2) d += total;
          const abs = Math.abs(d);

          if (abs > maxVisible) {
            card.style.transform = `translate3d(${d > 0 ? stepX * 3.4 : -stepX * 3.4}px, 120px, 0) scale(0.62)`;
            card.style.opacity = '0';
            card.style.pointerEvents = 'none';
            card.style.zIndex = '1';
            card.tabIndex = -1;
            card.setAttribute('aria-current', 'false');
            card.setAttribute('aria-hidden', 'true');
            return;
          }

          card.removeAttribute('aria-hidden');
          card.style.pointerEvents = 'auto';
          card.tabIndex = 0;

          if (d === 0) {
            card.style.transform = `translate3d(0px, ${centerLift}px, 0) rotate(0deg) scale(${centerScale})`;
            card.style.opacity = '1';
            card.style.filter = 'drop-shadow(0 28px 52px rgba(0,0,0,0.68))';
            card.style.zIndex = '50';
            card.setAttribute('aria-current', 'true');
          } else {
            const x = d * stepX;
            const y = abs === 1 ? 24 : abs === 2 ? 58 : 98;
            const rot = d * stepRot;
            const sc = abs === 1 ? 0.89 : abs === 2 ? 0.79 : 0.69;
            const br = abs === 1 ? 0.76 : abs === 2 ? 0.52 : 0.34;
            card.style.transform = `translate3d(${x}px, ${y}px, 0) rotate(${rot}deg) scale(${sc})`;
            card.style.opacity = '1';
            card.style.filter = `grayscale(1) brightness(${br})`;
            card.style.zIndex = String(40 - abs * 10);
            card.setAttribute('aria-current', 'false');
          }
        });

        const activeCard = pool[activePoolPos];
        if (activeCard) {
          const pad = (n: number) => String(n).padStart(2, '0');
          if (readoutIdx) readoutIdx.textContent = `${pad(activePoolPos + 1)} / ${pad(total)}`;
          if (readoutHandle)
            readoutHandle.textContent = `${activeCard.dataset.platform} · ${activeCard.dataset.handle}`;
          if (readoutRole) readoutRole.textContent = activeCard.dataset.role || '';
          if (readoutName) readoutName.textContent = activeCard.dataset.name || '';
          if (readoutFollowers) readoutFollowers.textContent = activeCard.dataset.followers || '';
          if (readoutReach) readoutReach.textContent = activeCard.dataset.reach || '';
          if (readoutProgress) {
            const pct = Math.max(8, Math.round(((activePoolPos + 1) / total) * 100));
            readoutProgress.style.width = `${pct}%`;
          }
        }
      };

      fanCards.forEach((card) => {
        card.addEventListener('click', () => {
          const pool = getPool();
          const clickedPos = pool.indexOf(card);
          if (clickedPos === -1) return;
          if (clickedPos === activePoolPos) {
            activePoolPos = (activePoolPos + 1) % pool.length;
          } else {
            activePoolPos = clickedPos;
          }
          renderFan();
        });
      });

      nicheBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          currentNiche = btn.dataset.socialNiche || 'all';
          activePoolPos = 0;
          nicheBtns.forEach((b) => {
            const selected = b === btn;
            b.setAttribute('aria-pressed', selected ? 'true' : 'false');
            b.classList.toggle('bg-[#b84334]', selected);
            b.classList.toggle('text-white', selected);
            b.classList.toggle('border-[#d66151]', selected);
            b.classList.toggle('bg-[#1a1816]', !selected);
            b.classList.toggle('text-[#b5aea4]', !selected);
            b.classList.toggle('border-[#736b63]', !selected);
          });
          renderFan();
        });
      });

      fanPrev?.addEventListener('click', () => {
        activePoolPos -= 1;
        renderFan();
      });

      fanNext?.addEventListener('click', () => {
        activePoolPos += 1;
        renderFan();
      });

      fanRegion?.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowLeft') {
          e.preventDefault();
          activePoolPos -= 1;
          renderFan();
        } else if (e.key === 'ArrowRight') {
          e.preventDefault();
          activePoolPos += 1;
          renderFan();
        }
      });

      let startX: number | null = null;
      fanStage?.addEventListener('pointerdown', (e) => {
        startX = e.clientX;
      });
      fanStage?.addEventListener('pointerup', (e) => {
        if (startX === null) return;
        const delta = e.clientX - startX;
        startX = null;
        if (Math.abs(delta) > 42) {
          activePoolPos += delta < 0 ? 1 : -1;
          renderFan();
        }
      });

      let resizeTimer: number | undefined;
      window.addEventListener('resize', () => {
        window.clearTimeout(resizeTimer);
        resizeTimer = window.setTimeout(renderFan, 90);
      });

      renderFan();
    }

    const filterBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-testimony-filter]'));
    const reviewCards = Array.from(document.querySelectorAll<HTMLElement>('[data-testimony-card]'));
    const expandBtn = document.getElementById('testimony-expand-btn');
    const expandWrap = document.getElementById('testimony-toggle-wrap');
    const expandLabel = document.getElementById('testimony-expand-label');
    const expandIcon = document.getElementById('testimony-expand-icon');

    if (filterBtns.length && reviewCards.length) {
      let activeFilter = 'featured';

      const applyReviewFilter = (nextFilter: string) => {
        activeFilter = nextFilter;

        filterBtns.forEach((btn) => {
          const selected = btn.dataset.testimonyFilter === activeFilter;
          btn.setAttribute('aria-pressed', selected ? 'true' : 'false');
          btn.classList.toggle('bg-[#f3efe9]', selected);
          btn.classList.toggle('text-[#121110]', selected);
          btn.classList.toggle('border-[#f3efe9]', selected);
          btn.classList.toggle('bg-[#181614]', !selected);
          btn.classList.toggle('text-[#b5aea4]', !selected);
          btn.classList.toggle('border-[#736b63]', !selected);
        });

        let visibleIdx = 0;
        reviewCards.forEach((card) => {
          const matches =
            activeFilter === 'all'
              ? true
              : activeFilter === 'featured'
                ? card.dataset.featured === 'true'
                : card.dataset.category === activeFilter;

          card.classList.toggle('hidden', !matches);
          card.classList.remove('lg:translate-y-7');
          if (matches) {
            if ((activeFilter === 'featured' || activeFilter === 'all') && visibleIdx % 3 === 1) {
              card.classList.add('lg:translate-y-7');
            }
            visibleIdx += 1;
          }
        });

        if (expandWrap && expandBtn && expandLabel && expandIcon) {
          const showToggle = activeFilter === 'featured' || activeFilter === 'all';
          expandWrap.classList.toggle('hidden', !showToggle);
          const expanded = activeFilter === 'all';
          expandBtn.setAttribute('aria-expanded', expanded ? 'true' : 'false');
          expandLabel.textContent = expanded
            ? 'Ringkas ke 6 Ulasan Pilihan'
            : 'Tampilkan 6 Ulasan Anggota Lainnya (Total 12)';
          expandIcon.classList.toggle('rotate-180', expanded);
        }
      };

      filterBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          applyReviewFilter(btn.dataset.testimonyFilter || 'featured');
        });
      });

      expandBtn?.addEventListener('click', () => {
        applyReviewFilter(activeFilter === 'all' ? 'featured' : 'all');
      });
    }
  })();
</script>
