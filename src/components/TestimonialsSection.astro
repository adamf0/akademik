function getInitialFanStyle(idx: number, total: number) {
  let d = idx;
  if (d > total / 2) d -= total;
  const abs = Math.abs(d);
  if (abs > 3) {
    return 'transform: translate3d(0px, 120px, 0) scale(0.6); opacity: 0; pointer-events: none; z-index: 1;';
  }
  if (d === 0) {
    return 'transform: translate3d(0px, -8px, 0) rotate(0deg) scale(1.06); opacity: 1; filter: drop-shadow(0 28px 52px rgba(0,0,0,0.68)); z-index: 50;';
  }
  const x = d * 136;
  const y = abs === 1 ? 24 : abs === 2 ? 58 : 98;
  const rot = d * 10.5;
  const sc = abs === 1 ? 0.89 : abs === 2 ? 0.79 : 0.69;
  const br = abs === 1 ? 0.76 : abs === 2 ? 0.52 : 0.34;
  const z = 40 - abs * 10;
  return `transform: translate3d(${x}px, ${y}px, 0) rotate(${rot}deg) scale(${sc}); opacity: 1; filter: grayscale(1) brightness(${br}); z-index: ${z};`;
}
